		{"id":"0bf3ed65b7d95029","type":"group","x":-280,"y":160,"width":405,"height":560,"label":"中转平台SDK等相关代码独立模块"},
		{"id":"988a6f82bd64eef6","type":"text","text":"用户操作总流程\nSTART","x":-200,"y":-100,"width":250,"height":60},
