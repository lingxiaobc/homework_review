    },
    {
      "id": "batch_id",
      "type": "text",
      "text": "批次ID<batch_id>PK，全局唯一",
      "x": -860,
      "y": -150,
      "width": 340,
      "height": 90
    },
    {
      "id": "batch_created_at",
      "type": "text",
      "text": "批次创建时间<created_at>timestamp，NOT NULL",
      "x": -860,
      "y": -20,
      "width": 340,
      "height": 90
    },
    {
      "id": "batch_note",
      "type": "text",
      "text": "说明：批次表不保存图片ID列表。一个批次包含多张图片，由 images.batch_id 建立 1:N 关系。",
      "x": -860,
      "y": 110,
      "width": 340,
      "height": 100
    },
    {
      "id": "image_id",
      "type": "text",
      "text": "图片ID<image_id>PK，全局唯一",
      "x": -210,
      "y": -350,
      "width": 440,
      "height": 80
    },
    {
      "id": "image_batch_id",
      "type": "text",
      "text": "所属批次ID<batch_id>FK → batches.batch_id，NOT NULL",
      "x": -210,
      "y": -245,
      "width": 440,
      "height": 90
    },
    {
      "id": "raw_image_key",
      "type": "text",
      "text": "原始图片存储标识<raw_image_key>对象存储 key / 稳定资源标识，对应的资源路径",
      "x": -210,
      "y": -125,
      "width": 440,
      "height": 90
    },
    {
      "id": "validation_status",
      "type": "text",
      "text": "审核状态 <validation_status>\nPENDING / PASSED / REJECTED / FAILED\nPASSED＝允许生图；质量/非物理均 REJECTED。",
      "x": -210,
      "y": -5,
      "width": 440,
      "height": 110
    },
    {
      "id": "fd4b052bf03fd05b",
      "type": "text",
      "text": "<created_at>创建时间，使用业务时间语义",
      "x": -210,
      "y": 383,
      "width": 440,
      "height": 60
    },
    {
      "id": "result_image_key",
      "type": "text",
      "text": "最终生成图片存储标识<result_image_key>可为 NULL；成功后写入，AI生成图片的资源路径",
      "x": -210,
      "y": 255,
      "width": 440,
      "height": 85
    },
    {
      "id": "image_times",
      "type": "text",
      "text": "时间字段<updated_at>使用业务时间语义",
      "x": -210,
      "y": 485,
      "width": 440,
      "height": 95
    },
    {
      "id": "image_status",
      "type": "text",
      "text": "当前处理状态<status>UPLOADED / VALIDATING / READY / GENERATING / SUCCEEDED / FAILED / REJECTED",
      "x": -210,
      "y": 115,
      "width": 440,
      "height": 110
    },
    {
      "id": "attempt_id",
      "type": "text",
      "text": "调用记录ID<attempt_id>PK，全局唯一",
      "x": 620,
      "y": -430,
      "width": 520,
      "height": 80
    },
    {
      "id": "attempt_image_id",
      "type": "text",
      "text": "对应图片ID<image_id>FK → images.image_id，NOT NULL",
      "x": 620,
      "y": -325,
      "width": 520,
      "height": 85
    },
    {
      "id": "validation_prompt_cfg",
      "type": "text",
      "text": "审核 Prompt（代码配置）\n只返回 is_physics / grading_advice。\n【重新上传】为建议固定前缀，优先于学科分流。\n潦草区域标问号，模糊反光打回。",
      "x": -210,
      "y": 1430,
      "width": 440,
      "height": 150
    },
    {
      "id": "generation_prompt_cfg",
      "type": "text",
      "text": "生图 Prompt（代码配置）\n原图＋固定规则＋已保存的 grading_advice。\n不重判题目，不补写学生作答。\n生成尝试保存实际 prompt_version。",
      "x": -210,
      "y": 1610,
      "width": 440,
      "height": 150
    },
    {
      "id": "2de532fb5bc566e9",
      "type": "text",
      "text": "新增 <grading_advice> TEXT NULL\n整页建议字符串，不拆逐题表。\n有效审核后必须非空；上传初始、审核失败及历史记录可 NULL。\n保存完整【重新上传】前缀及原因；正常、潦草、拒绝均保存。\n仅生图失败重试时复用，不覆盖。",
      "styleAttributes": {},
      "x": -210,
      "y": 610,
      "width": 440,
      "height": 210,
      "color": "1"
    },
    {
      "id": "attempt_no",
      "type": "text",
      "text": "第几次调用<attempt_no>1, 2, 3...建议 UNIQUE(image_id, attempt_no)",
      "x": 620,
      "y": -215,
      "width": 520,
      "height": 100
    },
    {
      "id": "model_id",
      "type": "text",
      "text": "模型ID<model_id>记录本次实际使用的生图模型",
      "x": 620,
      "y": -90,
      "width": 520,
      "height": 80
    },
    {
      "id": "prompt_version",
      "type": "text",
      "text": "生图提示词版本<prompt_version>记录本次调用实际使用的版本，例如 grading-v3",
      "x": 620,
      "y": 15,
      "width": 520,
      "height": 95
    },
    {
      "id": "attempt_status",
      "type": "text",
      "text": "本次调用状态<status>PROCESSING / SUCCEEDED / FAILED",
      "x": 620,
      "y": 135,
      "width": 520,
      "height": 85
    },
    {
      "id": "provider_request_id",
      "type": "text",
      "text": "平台请求ID<provider_request_id>ZenMux / 上游平台返回的 request id，可为 NULL",
      "x": 620,
      "y": 245,
      "width": 520,
      "height": 95
    },
    {
      "id": "ddd3715b25f3346a",
      "type": "text",
      "text": "<started_at>开始时间",
      "x": 735,
      "y": 383,
      "width": 250,
      "height": 60
    },
    {
      "id": "3abdaf073b82783e",
      "type": "text",
      "text": "<finished_at>结束时间",
      "x": 735,
      "y": 460,
      "width": 250,
      "height": 60
    },
    {
      "id": "8e633ff696d2b66d",
      "type": "text",
      "text": "<latency_ms>耗时",
      "x": 735,
      "y": 550,
      "width": 250,
      "height": 60
    },
    {
      "id": "650e56bb6488f2f8",
      "type": "text",
      "text": "<erroe_code>错误码，成功时为NULL",
      "x": 735,
      "y": 640,
      "width": 250,
      "height": 60
    },
    {
      "id": "602f525f0ef197cf",
      "type": "text",
      "text": "<error_type>错误类型成功时为NULL",
      "x": 735,
      "y": 730,
      "width": 250,
      "height": 60
    },
    {
      "id": "683c123885a3b61b",
      "type": "text",
      "text": "<error_message>错误信息，成功时可以为NULL",
      "x": 735,
      "y": 820,
      "width": 250,
      "height": 60
    },
    {
      "id": "is_physics",
      "type": "text",
      "x": -210,
      "y": 850,
      "width": 440,
      "height": 140,
      "color": "1",
      "text": "新增 <is_physics> INTEGER NULL\nCHECK (is_physics IN (0, 1))\nAPI 转为 boolean / null。历史未知不能转 false。\n与 grading_advice、审核状态同事务保存。"
    },
    {
      "id": "routing_note",
      "type": "text",
      "x": -210,
      "y": 1030,
      "width": 440,
      "height": 130,
      "text": "先检查建议【重新上传】前缀，再看 is_physics。\n整图不可辨认：false＋前缀，仅表示未确认。\n拒绝不创建生图尝试；不新增拒绝原因字段。"
    },
    {
      "id": "migration_note",
      "type": "text",
      "x": -860,
      "y": 440,
      "width": 430,
      "height": 270,
      "color": "1",
      "text": "V1.0.1 增量迁移\n保留原三表及字段，仅 images 加两列。\n检查列是否存在后加列，迁移可重复执行。\n不能只修改 CREATE TABLE IF NOT EXISTS。\n历史记录新列 NULL；不自动重新批改。\n旧失败无有效建议 → 重试先审核。\n文件名保留 V1.0.0 以兼容既有引用，图内容版本为 V1.0.1。"
    }
  ],
